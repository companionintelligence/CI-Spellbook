{
  "name": "ci-spellbook-react",
  "version": "1.1.0",
  "description": "Companion Intelligence Spellbook - React Version",
  "private": true,
  "type": "module",
  "dependencies": {
    "@sentry/react": "^10.69.0",
    "@tailwindcss/vite": "^4.1.7",
    "classnames": "^2.3.2",
    "highlight.js": "^11.9.0",
    "marked": "^5.1.1",
    "marked-highlight": "^2.2.4",
    "minisearch": "^7.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^4.1.7",
    "@companionintelligence/tokens": "^1.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.0.3",
    "jsdom": "^30.0.1",
    "vite": "^5.4.19",
    "vitest": "^4.1.10",
    "@companionintelligence/config": "^1.2.0",
    "@companionintelligence/assets": "^1.5.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build-css": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --watch",
    "serve": "python3 -m http.server 8080",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "assert:no-sentry-without-dsn": "node scripts/assert-bundle-without-dsn.mjs",
    "assert:site": "node scripts/assert-site.mjs",
    "check:ga-build": "node scripts/check-ga-build.mjs",
    "check:lockfiles": "node scripts/check-lockfiles.mjs",
    "lint:content": "node dev-tools/lint-content.mjs",
    "check:links": "node dev-tools/check-links.mjs",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "lint:canon": "ci-lint-canon . && node scripts/sync-brand.mjs --check",
    "brand:sync": "node scripts/sync-brand.mjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
