<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- The theme the app runs in after the splash. Dark-only: the parent is the dark AppCompat
         theme (not DayNight), so the system bars draw light glyphs whatever the phone's setting.
         From Android 15 (targetSdk 35+) the window is edge-to-edge and the system bars are
         transparent; Capacitor insets the WebView (the SystemBars plugin) and the strips
         behind the bars show this window background. Left at the default it is near-white, which
         puts white status-bar glyphs on white. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/spellbookBackground</item>
        <!-- Before Android 15 the bars are opaque and take these instead. -->
        <item name="android:statusBarColor">@color/spellbookBackground</item>
        <item name="android:navigationBarColor">@color/spellbookBackground</item>
    </style>


    <!-- Android 12+ shows the system splash (launcher icon on a flat colour) and ignores
         android:background; older versions show the drawable/splash image. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/spellbookBackground</item>
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>