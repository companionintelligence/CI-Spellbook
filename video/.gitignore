# rendered videos — regenerate with `./video/make.sh`
out/

# captured screenshots — regenerate with `./video/make.sh`. They are inputs to
# the render, not artefacts worth keeping: capturing locally is cheap, and a
# committed screenshot that nothing refreshes is worse than no screenshot,
# because it goes on looking current long after the UI has moved.
assets/shots/

# generated compositions — regenerate with `ci-video build`. Not in the kit's
# template, but build/ holds a symlink (assets -> ../../assets) and a 19 KB
# generated index.html per format that is rewritten on every kit upgrade.
# The workflow runs `npm run build` before `npm run check`, so nothing needs it
# committed.
build/

# playwright auth state
.auth/

node_modules/
