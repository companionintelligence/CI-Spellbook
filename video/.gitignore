# rendered videos — regenerate with `./video/make.sh`
out/

# NOTE: captured screenshots are deliberately COMMITTED, not ignored. Ignoring
# them is right in principle — they are regenerable inputs — but today only a few
# repos have a working local stage recipe, so a fresh clone could not render this
# video at all, and `ci-video check` fails on missing shots by design. Revisit
# once local capture works everywhere.

# generated compositions — regenerate with `ci-video build`. Not in the kit's
# template, but build/ holds a symlink (assets -> ../../assets) and a 19 KB
# generated index.html per format that is rewritten on every kit upgrade.
# The local runner rebuilds it before every check/render, so nothing needs it
# committed.
build/

# playwright auth state
.auth/

node_modules/

# npm install writes this when the toolchain is installed; the project has never
# had one and both make.sh and the workflow use `npm install`, so committing it
# now would quietly change how the video toolchain resolves.
package-lock.json

# Captured screenshots. These were re-committed in #35, on the reasoning that a
# clone with no way to re-capture cannot render at all — which is right for a
# product whose UI cannot be staged locally. It does not apply here: this repo
# has a verified ./video/make.sh that boots the app and re-shoots every screen,
# so the shots are reproducible on demand.
#
# So they are inputs to the render, not artefacts worth keeping — and a
# committed screenshot that nothing refreshes goes on looking current long after
# the UI has moved, which is worse than having none.
assets/shots/
