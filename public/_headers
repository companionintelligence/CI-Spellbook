# Cloudflare Pages response headers (magic.ci.computer). Pages reads this file from
# the build output; it is not used by the nginx container image, which has its own
# conf in nginx/default.conf.
#
# The CSP is strict on purpose: no 'unsafe-inline' for scripts or styles. That holds
# because the page ships no inline script (only an application/ld+json data block,
# which CSP does not govern) and no inline style: the body gradient lives in
# src/styles.css, and React sets the few per-shelf colours through the CSSOM, which
# style-src does not restrict.
#
#   - No analytics hosts: this file, as committed, allows none, and the page carries no
#     analytics. A build given GA_MEASUREMENT_ID (the Pages build) adds the tags AND
#     rewrites this CSP line in dist/_headers to allow Google's hosts, in script-src,
#     connect-src and img-src and nowhere else (scripts/ga4.mjs). Do not add them
#     here: the container image shares this bundle and must stay analytics-free.
#   - No Sentry host: crash reporting asks /api/config/telemetry first, and a static
#     host has no such endpoint (it is a real 404 now, see public/404.html), so the
#     bundle stays silent here. If reporting is ever enabled on Pages, add the
#     DSN's ingest host to connect-src and `worker-src blob:` for session replay.
#   - Cloudflare's own injected snippets (JavaScript Detections) are inline and so
#     are not allowed; blocking them only costs bot scoring, not the page.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=()
  Strict-Transport-Security: max-age=31536000

# Fingerprinted by Vite (the shelf art is imported, so it is in here too).
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Unfingerprinted, but they change on a rebrand, not on a deploy.
/logo/*
  Cache-Control: public, max-age=604800
/og-image.png
  Cache-Control: public, max-age=86400

# The catalog itself. Short, so a merged content update reaches readers within
# minutes, with stale-while-revalidate so repeat visits are instant.
/markdown/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
